<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.3m.giam-sat</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/david/Developments/3m-operations/van-hanh/hang-ngay.sh</string>
  </array>

  <!-- Bốn lượt một ngày. Nguồn chặn theo IP và IP nhà thay đổi, nên chạy
       nhiều lượt để một lượt hỏng không làm số liệu cũ cả ngày. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <!-- Máy ngủ qua giờ hẹn thì chạy bù ngay khi thức. -->
  <key>RunAtLoad</key><false/>

  <key>StandardOutPath</key>
  <string>/Users/david/Developments/3m-operations/van-hanh/log/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/david/Developments/3m-operations/van-hanh/log/launchd.err</string>
</dict>
</plist>
