# Chép thành .env.local ở thư mục gốc. Agent tự nạp file này.
# Kho số liệu gộp
WAREHOUSE_URL=postgres://user:pass@localhost:5432/3m_warehouse

# Khoá của Anthropic. Bỏ trống được nếu đã chạy `ant auth login`.
ANTHROPIC_API_KEY=

# Giao diện. Next.js chỉ đọc web/.env.local nên ba biến này phải nằm ở đó.
MONITOR_USER=traidot
MONITOR_PASSWORD=tinhban

# Google Sheets của marketing
ADS_SHEETS=[{"owner":"dinh_viet","id":"..."},{"owner":"viet_hoang","id":"..."},{"owner":"techno","id":"..."}]

# Cách 1 — tài khoản của chính anh, dùng khi sheet đã được share cho anh.
# Lấy refresh token một lần bằng `npm run google:auth`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Cách 2 — tài khoản dịch vụ. Bền hơn nhưng phải nhờ chủ sheet share thêm.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# Hệ thống nguồn. Dùng tài khoản CHỈ ĐỌC, không dùng root.
SRC_FIXED_URL=mysql://monitor_ro:...@host:33308/wifi-api

# Hệ telecom (wifi cầm tay), PostgreSQL trên RDS. Dùng tài khoản chỉ đọc.
SRC_TELECOM_URL=postgres://monitor_ro:...@host:5432/postgres
# Tuỳ chọn: file PEM chứng chỉ gốc của Amazon RDS. Không đặt thì vẫn mã hoá
# đường truyền nhưng bỏ qua bước kiểm chứng chỉ.
# SRC_TELECOM_CA=/duong/dan/rds-ca.pem
