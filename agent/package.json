{
  "name": "3m-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "digest": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/index.ts",
    "weekly": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/index.ts --weekly",
    "sync": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/sync/run.ts",
    "ads": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/ads/import.ts",
    "ads:sync": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/ads/sync.ts",
    "google:auth": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/ads/google-auth.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "kho:nhap": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/kho/nhap-doi-soat.ts",
    "sao-ke:nhap": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/sao-ke/nhap.ts",
    "doi-chieu:cuoc-tk": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/doi-chieu/cuoc-vs-tai-khoan.ts",
    "sao-ke:doi-soat": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/sao-ke/doi-soat.ts",
    "bao-cao:cms": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/doi-chieu/bao-cao-cms.ts",
    "kiem-ke:nhap": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/kiem-ke/nhap.ts",
    "kiem-ke:doi-soat": "tsx --env-file-if-exists=../.env.local --env-file-if-exists=.env src/kiem-ke/doi-soat.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "mysql2": "^3.24.4",
    "pg": "^8.13.1",
    "zod": "^4.0.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
